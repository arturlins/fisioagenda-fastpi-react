# Ensaio local. Copie para infra/.env (ignorado pelo Git).
# 127-0-0-1.sslip.io resolve para 127.0.0.1; o Caddy usa certificado interno.
DOMINIO_BASE=127-0-0-1.sslip.io
TLS_MODO=internal
REGISTRO=fisioagenda-local
VERSAO_IMAGENS=ensaio

POSTGRES_SUPERUSER_PASSWORD=EnsaioPostgres2026
APP_DB_USER=fisioagenda_app
APP_DB_PASSWORD=EnsaioAplicacao2026
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=EnsaioKeycloakBanco2026
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=EnsaioKeycloakAdmin2026
KEYCLOAK_BACKEND_CLIENT_SECRET=EnsaioSegredoBackend2026
# Só no ensaio: o realm de produção não leva o client de testes.
KEYCLOAK_TESTES_CLIENT_SECRET=EnsaioSegredoTestes2026
SEMEAR_SENHA=EnsaioDemonstracao2026
