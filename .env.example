# Variáveis da infraestrutura local (docker compose).
# Copie para .env e troque todos os valores. O .env está no .gitignore.
#
#   cp .env.example .env
#
# Estes valores são de DESENVOLVIMENTO. Em qualquer ambiente compartilhado,
# gere segredos novos e guarde-os fora do repositório.

# --- PostgreSQL ---------------------------------------------------------------
# Publicado em 127.0.0.1:5433 para não colidir com uma instalação nativa na 5432.
POSTGRES_SUPERUSER_PASSWORD=troque-este-valor
APP_DB_USER=fisioagenda_app
APP_DB_PASSWORD=troque-este-valor
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=troque-este-valor

# --- Keycloak -----------------------------------------------------------------
# Console administrativo em http://127.0.0.1:8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=troque-este-valor

# Segredo do client confidencial usado pelo backend (service account da Admin API).
KEYCLOAK_BACKEND_CLIENT_SECRET=troque-este-valor

# Segredo do client usado apenas pelos testes de integração (Direct Access Grant).
# Existe somente no realm de desenvolvimento.
KEYCLOAK_TESTES_CLIENT_SECRET=troque-este-valor
