# Configuração da API. Copie para backend/.env — o .env está no .gitignore.
#
# A senha do banco não tem default: sem ela a aplicação não sobe. É proposital.

AMBIENTE=desenvolvimento

# --- Banco --------------------------------------------------------------------
# Valores casam com o compose da raiz (Postgres publicado em 127.0.0.1:5433).
BANCO_HOST=127.0.0.1
BANCO_PORTA=5433
BANCO_NOME=fisioagenda
BANCO_USUARIO=fisioagenda_app
BANCO_SENHA=igual-ao-APP_DB_PASSWORD-do-.env-da-raiz
BANCO_ECHO=false

# --- HTTP ---------------------------------------------------------------------
HTTP_HOST=127.0.0.1
HTTP_PORTA=8000
CORS_ORIGENS=["http://localhost:5173"]

# --- Log ----------------------------------------------------------------------
LOG_NIVEL=INFO
LOG_FORMATO=json

# --- Keycloak -----------------------------------------------------------------
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=fisioagenda
KEYCLOAK_CLIENT_ID=fisioagenda-backend
KEYCLOAK_CLIENT_SECRET=igual-ao-KEYCLOAK_BACKEND_CLIENT_SECRET-do-.env-da-raiz
